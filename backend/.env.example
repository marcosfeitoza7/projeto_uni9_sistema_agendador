# URL do seu projeto Supabase (Settings > API)
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Service Role Key (Settings > API > service_role)
# NUNCA exponha essa chave no front-end: ela ignora o RLS.
# Use apenas aqui, no backend.
SUPABASE_SERVICE_ROLE_KEY=coloque-sua-chave-aqui

# Porta em que a API vai rodar localmente
PORT=3333

# Origem permitida para o CORS (endereço do seu front-end)
FRONTEND_URL=http://localhost:5173
